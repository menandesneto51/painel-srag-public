{
  "model_id": "srag_mt_silence_v2",
  "version": "2.0.0-experimental",
  "status": "experimental",
  "min_baseline_years": 3,
  "priority_expected_median": 2.0,
  "regional_priority_signals": [
    "persistent_elevated"
  ],
  "classes": [
    "not_silent",
    "absence_compatible_with_expected",
    "silence_under_investigation",
    "silence_priority_candidate",
    "data_quality_or_reporting_gap",
    "insufficient_baseline"
  ],
  "rules": {
    "zero_is_not_silence_by_itself": true,
    "explicit_zero_reporting_supported": true,
    "recent_reporting_evidence_is_proxy_only": true,
    "risk_classification_enabled": false
  }
}
